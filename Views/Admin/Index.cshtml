@{
    ViewData["Title"] = "Panel Administratora";
}

<div class="container mt-5 text-center">
    <h1 class="mb-5">Panel Administracyjny</h1>

    <div class="row justify-content-center">
        <div class="col-md-4 mb-4">
            <a href="@Url.Action("Tasks", "Admin")" class="btn btn-lg btn-primary w-100 py-4 shadow-sm">
                <i class="bi bi-list-ul me-2"></i> Zarządzaj Zadaniami
            </a>
        </div>
        <div class="col-md-4 mb-4">
            <a href="@Url.Action("Submissions", "Admin")" class="btn btn-lg btn-warning w-100 py-4 shadow-sm text-dark">
                <i class="bi bi-envelope-open-text me-2"></i> Weryfikuj Zgłoszenia
            </a>
        </div>
        <div class="col-md-4 mb-4">
            <a href="@Url.Action("Leaderboard", "Admin")" class="btn btn-lg btn-info w-100 py-4 shadow-sm text-white">
                <i class="bi bi-trophy me-2"></i> Ranking Uczestników
            </a>
        </div>
    </div>
</div>
