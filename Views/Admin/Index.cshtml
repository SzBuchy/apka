@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-5 text-center">
    <h1 class="mb-5">Administrator</h1>

    <div class="row justify-content-center">
        <div class="col-md-4 mb-4">
            <a href="@Url.Action("Tasks", "Admin")" class="btn btn-lg btn-primary w-100 py-4">
                <i class="bi bi-list-ul me-2"></i> Manage Tasks
            </a>
        </div>
        <div class="col-md-4 mb-4">
            <a href="@Url.Action("Submissions", "Admin")" class="btn btn-lg btn-warning w-100 py-4">
                <i class="bi bi-envelope-open-text me-2"></i> Review Submissions
            </a>
        </div>
        <div class="col-md-4 mb-4">
            <a href="@Url.Action("Leaderboard", "Admin")" class="btn btn-lg btn-info w-100 py-4">
                <i class="bi bi-trophy me-2"></i> Results Board
            </a>
        </div>
    </div>
</div>
