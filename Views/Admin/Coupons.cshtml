@model List<EventManageApp.Models.Coupon>

@{
    ViewData["Title"] = "Zarządzanie Kuponami";
    var users = ViewBag.Users as List<EventManageApp.Models.User>;
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1><i class="bi bi-ticket-perforated"></i> Zarządzanie Kuponami</h1>
            <p class="text-muted">Generuj i przypisuj kupony użytkownikom</p>
        </div>
        <div class="col-md-4 text-end">
            <button class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#createCouponModal">
                <i class="bi bi-plus-circle"></i> Utwórz Nowy Kupon
            </button>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Numer Seryjny</th>
                        <th>Użytkownik</th>
                        <th>Tytuł</th>
                        <th>Ważność</th>
                        <th>Status</th>
                        <th>Zeskanował</th>
                        <th class="text-center">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var coupon in Model)
                    {
                        <tr>
                            <td><code>@coupon.SerialNumber</code></td>
                            <td>@(coupon.User?.Nickname ?? coupon.User?.Login ?? "Nieznany")</td>
                            <td>@coupon.Title</td>
                            <td>
                                <small>@coupon.StartDate.ToString("dd.MM") - @coupon.EndDate.ToString("dd.MM")</small>
                            </td>
                            <td>
                                @if (coupon.IsUsed)
                                {
                                    <span class="badge bg-secondary">ZUŻYTY</span>
                                }
                                else if (DateTime.Now > coupon.EndDate)
                                {
                                    <span class="badge bg-danger">WYGASŁ</span>
                                }
                                else if (DateTime.Now < coupon.StartDate)
                                {
                                    <span class="badge bg-info">NADCHODZĄCY</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">AKTYWNY</span>
                                }
                            </td>
                            <td>@(coupon.ScannedBy ?? "—")</td>
                            <td class="text-center">
                                <form asp-action="DeleteCoupon" method="post" onsubmit="return confirm('Usunąć ten kupon?');">
                                    <input type="hidden" name="id" value="@coupon.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Coupon Modal -->
<div class="modal fade" id="createCouponModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Generuj Nowy Kupon</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateCoupon" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Tytuł Kuponu</label>
                        <input type="text" name="title" class="form-control" placeholder="np. Kupon na lunch" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Przypisz do użytkownika</label>
                        <select name="userId" class="form-select" required>
                            <option value="-1" class="text-primary fw-bold">--- WSZYSCY ---</option>
                            @foreach (var user in users!)
                            {
                                <option value="@user.Id">@(user.Nickname ?? user.Login)</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Data rozpoczęcia</label>
                            <input type="date" name="startDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Data zakończenia</label>
                            <input type="date" name="endDate" class="form-control" value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anuluj</button>
                    <button type="submit" class="btn btn-primary">Generuj Kupon</button>
                </div>
            </form>
        </div>
    </div>
</div>
