@model EventManageApp.Models.Task

@{
    ViewData["Title"] = "Create Task";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <a href="@Url.Action("Tasks", "Admin")" class="btn btn-secondary mb-3">← Back to Tasks</a>
            <h1>Create New Task</h1>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form method="post" asp-action="CreateTask">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Task Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Enter task name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Enter task description"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Points" class="form-label">Points</label>
                            <input asp-for="Points" type="number" class="form-control" placeholder="0" />
                            <span asp-validation-for="Points" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RequiresPhoto" class="form-check-input" type="checkbox" />
                            <label asp-for="RequiresPhoto" class="form-check-label">
                                Require Photo Submission
                            </label>
                            <small class="d-block text-muted mt-2">When enabled, users must submit both text and a photo to complete this task.</small>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="@Url.Action("Tasks", "Admin")" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-success">Create Task</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}