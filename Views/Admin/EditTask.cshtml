@model EventManageApp.Models.Task

@{
    ViewData["Title"] = "Edit Task";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="row mb-4">
                <div class="col-md-10">
                    <a href="@Url.Action("Tasks", "Admin")" class="btn btn-secondary mb-3">← Back to Tasks</a>
                    <h1>Edit Task</h1>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form method="post" asp-action="EditTask">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Task Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Enter task name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Enter task description"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Points" class="form-label">Points</label>
                            <input asp-for="Points" type="number" class="form-control" placeholder="0" />
                            <span asp-validation-for="Points" class="text-danger"></span>
                            <small class="text-muted">Points that users will earn when completing this task</small>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RequiresPhoto" class="form-check-input" type="checkbox" />
                            <label asp-for="RequiresPhoto" class="form-check-label">
                                Require Photo or Video Submission
                            </label>
                            <small class="d-block text-muted mt-2">When enabled, users must submit a photo or video. The text answer becomes optional.</small>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Task Status</label>
                            <select class="form-select">
                                <option selected>Active</option>
                                <option>Inactive</option>
                                <option>Archived</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Assigned To</label>
                            <select class="form-select" multiple>
                                <option>User 1</option>
                                <option>User 2</option>
                                <option>User 3</option>
                            </select>
                            <small class="text-muted">Hold Ctrl/Cmd to select multiple users</small>
                        </div>

                        <hr />

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="@Url.Action("Tasks", "Admin")" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
