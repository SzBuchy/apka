@model EventManageApp.Models.TaskSubmission

@{
    ViewData["Title"] = "Recenzja Zgłoszenia";
    var task = ViewBag.Task as EventManageApp.Models.Task;
    var user = ViewBag.User as EventManageApp.Models.User;
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-12">
            <a href="@Url.Action("Submissions", "Admin")" class="btn btn-secondary mb-3">← Powrót do zgłoszeń</a>
            <h1>Recenzja Zgłoszenia</h1>
        </div>
    </div>

    <div class="row">
        <!-- Submission Details -->
        <div class="col-md-8">
            <!-- User & Task Info -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Informacje o zgłoszeniu</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Zadanie:</strong> @task?.Name</p>
                            <p><strong>Punkty do zdobycia:</strong> <span class="badge bg-success">@task?.Points pkt</span></p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Użytkownik:</strong> @(user?.Nickname ?? user?.Login)</p>
                            <p><strong>Imię i Nazwisko:</strong> @user?.FirstName @user?.LastName</p>
                            <p><strong>Punkty użytkownika:</strong> <span class="badge bg-info text-white">@user?.Points</span></p>
                        </div>
                    </div>
                    <hr />
                    <p><strong>Przesłano:</strong> @Model?.SubmittedAt.ToString("dddd, dd MMMM yyyy 'o' HH:mm:ss")</p>
                    <p><strong>Status:</strong>
                        @if (Model?.IsApproved ?? false)
                        {
                            <span class="badge bg-success">Zatwierdzone</span>
                        }
                        else if (Model?.IsRejected ?? false)
                        {
                            <span class="badge bg-danger">Odrzucone</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Oczekuje na weryfikację</span>
                        }
                    </p>
                </div>
            </div>

            <!-- Task Description -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Opis zadania</h5>
                </div>
                <div class="card-body">
                    <p>@task?.Description</p>
                </div>
            </div>

            <!-- User's Answer -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Odpowiedź użytkownika</h5>
                </div>
                <div class="card-body">
                    <div class="submission-answer" style="background-color: #f8f9fa; padding: 15px; border-radius: 5px; white-space: pre-wrap; font-family: monospace; max-height: 400px; overflow-y: auto;">
                        @Model?.Answer
                    </div>
                </div>
            </div>

            <!-- Submitted Photo/Video/File -->
            @if (!string.IsNullOrEmpty(Model?.CloudinaryUrl) || (Model?.SubmissionFile != null && Model.SubmissionFile.Length > 0))
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Przesłane zdjęcie/wideo</h5>
                    </div>
                    <div class="card-body text-center">
                        @if (!string.IsNullOrEmpty(Model.CloudinaryUrl))
                        {
                            @if (Model.FileContentType?.StartsWith("video/") == true || Model.CloudinaryUrl.EndsWith(".mp4") || Model.CloudinaryUrl.EndsWith(".mov"))
                            {
                                <video controls class="img-fluid rounded shadow-sm" style="max-width: 100%; max-height: 500px;">
                                    <source src="@Model.CloudinaryUrl" type="@Model.FileContentType">
                                    Twoja przeglądarka nie obsługuje tagu wideo.
                                </video>
                            }
                            else
                            {
                                <a href="@Model.CloudinaryUrl" target="_blank">
                                    <img src="@Model.CloudinaryUrl" 
                                         alt="Zgłoszenie" 
                                         class="img-fluid rounded shadow-sm" 
                                         style="max-width: 100%; max-height: 500px;" />
                                </a>
                            }
                            <p class="text-muted mt-2 mb-0">
                                <small>Przechowywane w Cloudinary</small>
                            </p>
                        }
                    </div>
                </div>
            }

            <!-- Approval/Rejection Form -->
            @if (!(Model?.IsApproved ?? false) && !(Model?.IsRejected ?? false))
            {
                <div class="card shadow-sm border-primary mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Decyzja</h5>
                    </div>
                    <div class="card-body">
                        <form method="post" id="approvalForm">
                            <input type="hidden" name="id" value="@Model?.Id" />

                            <div class="mb-3">
                                <label for="approvalNotes" class="form-label">Notatki do zatwierdzenia (dla użytkownika)</label>
                                <textarea class="form-control" id="approvalNotes" name="approvalNotes" rows="3" placeholder="Przekaż opinię użytkownikowi..."></textarea>
                            </div>

                            <div class="mb-3">
                                <label for="rejectionReason" class="form-label">Powód odrzucenia</label>
                                <textarea class="form-control" id="rejectionReason" name="rejectionReason" rows="3" placeholder="Wyjaśnij, dlaczego zgłoszenie zostało odrzucone..."></textarea>
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <button type="submit" formaction="@Url.Action("RejectSubmission", "Admin")" formmethod="post" class="btn btn-danger" onclick="return confirm('Czy na pewno chcesz odrzucić to zgłoszenie?');">
                                    <i class="bi bi-x-circle"></i> Odrzuć
                                </button>
                                <button type="submit" formaction="@Url.Action("ApproveSubmission", "Admin")" formmethod="post" class="btn btn-success btn-lg">
                                    <i class="bi bi-check-circle"></i> Zatwierdź i przyznaj punkty
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else if (Model?.IsApproved == true)
            {
                <div class="alert alert-success d-flex justify-content-between align-items-center" role="alert">
                    <div>
                        <h5 class="alert-heading mb-1">
                            <i class="bi bi-check-circle"></i> Zgłoszenie zatwierdzone
                        </h5>
                        <p class="mb-0">To zgłoszenie zostało zatwierdzone. Punkty zostały przyznane użytkownikowi.</p>
                    </div>
                    <form method="post" asp-action="ChangeDecision">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-success btn-sm">
                            <i class="bi bi-arrow-counterclockwise"></i> Zmień decyzję
                        </button>
                    </form>
                </div>
                
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <p><strong>Zatwierdził:</strong> @Model?.ApprovedBy</p>
                        <p><strong>Data zatwierdzenia:</strong> @Model?.ApprovedAt?.ToString("dddd, dd MMMM yyyy 'o' HH:mm:ss")</p>
                        @if (!string.IsNullOrEmpty(Model?.ApprovalNotes))
                        {
                            <p class="mb-0"><strong>Notatki:</strong> @Model?.ApprovalNotes</p>
                        }
                    </div>
                </div>
            }
            else if (Model?.IsRejected == true)
            {
                <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
                    <div>
                        <h5 class="alert-heading mb-1">
                            <i class="bi bi-x-circle"></i> Zgłoszenie odrzucone
                        </h5>
                        <p class="mb-0">To zgłoszenie zostało odrzucone. Punkty nie zostały przyznane.</p>
                    </div>
                    <form method="post" asp-action="ChangeDecision">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-arrow-counterclockwise"></i> Zmień decyzję
                        </button>
                    </form>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <p class="mb-0"><strong>Powód odrzucenia:</strong> @Model?.RejectionReason</p>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-md-4">
            <!-- Quick Stats -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Szybkie statystyki</h5>
                </div>
                <div class="card-body">
                    <p class="mb-2">
                        <strong>Długość odpowiedzi:</strong><br>
                        <span class="badge bg-info text-white">@Model?.Answer?.Length znaków</span>
                    </p>
                    <p>
                        <strong>Dni w oczekiwaniu:</strong><br>
                        <span class="badge bg-warning text-dark">@((DateTime.Now - (Model?.SubmittedAt ?? DateTime.Now)).Days) dni</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
