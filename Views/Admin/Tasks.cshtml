@model List<EventManageApp.Models.Task>

@{
    ViewData["Title"] = "Manage Tasks";
    var tasks = Model ?? new List<EventManageApp.Models.Task>();
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-0">
                <i class="bi bi-gear"></i> Task Management
            </h1>
            <p class="text-muted">Manage all tasks in the system</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("CreateTask", "Admin")" class="btn btn-success">+ Create New Task</a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-muted">Total Tasks</h6>
                    <h3 class="text-primary">@tasks.Count</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-muted">Total Points</h6>
                    <h3 class="text-success">@(tasks.Sum(t => t.Points))</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-muted">Avg Points</h6>
                    <h3 class="text-info">@(tasks.Count > 0 ? Math.Round(tasks.Average(t => t.Points), 1) : 0)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-muted">Users Assigned</h6>
                    <h3 class="text-warning">--</h3>
                </div>
            </div>
        </div>
    </div>

    @if (tasks != null && tasks.Count > 0)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">All Tasks</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Task Name</th>
                            <th>Description</th>
                            <th class="text-center">Points</th>
                            <th class="text-center">Media Req.</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@(task.Name ?? "Unnamed Task")</strong>
                                </td>
                                <td>
                                    <small class="text-muted">@(task.Description ?? "No description")</small>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-success">@task.Points pts</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info">Active</span>
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("EditTask", "Admin", new { id = task.Id })" class="btn btn-sm btn-primary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <form method="post" asp-action="DeleteTask" asp-controller="Admin" style="display:inline;">
                                    <input type="hidden" name="id" value="@task.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this task?');">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center mt-4">
            <h5>No tasks found</h5>
            <p>Create a new task to get started</p>
            <a href="#" class="btn btn-success">Create First Task</a>
        </div>
    }
</div>

@section Scripts {
    <!-- No additional scripts needed for task management at this time -->
}
