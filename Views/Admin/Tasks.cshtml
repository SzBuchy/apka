@model List<EventManageApp.Models.Task>

@{
    ViewData["Title"] = "Zarządzanie Zadaniami";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-0">
                <i class="bi bi-list-check"></i> Zarządzanie Zadaniami
            </h1>
            <p class="text-muted">Twórz, edytuj i usuwaj zadania dla uczestników</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("CreateTask", "Admin")" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle"></i> Dodaj Nowe Zadanie
            </a>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nazwa</th>
                            <th>Opis</th>
                            <th class="text-center">Punkty</th>
                            <th class="text-center">Foto/Wideo</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model)
                        {
                            <tr>
                                <td class="fw-bold">@task.Name</td>
                                <td class="text-muted">@(task.Description?.Length > 100 ? task.Description.Substring(0, 100) + "..." : task.Description)</td>
                                <td class="text-center">
                                    <span class="badge bg-success">@task.Points pkt</span>
                                </td>
                                <td class="text-center">
                                    @if (task.RequiresPhoto)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-camera"></i> Wymagane</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted">Nie</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="@Url.Action("EditTask", "Admin", new { id = task.Id })" class="btn btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Edytuj
                                        </a>
                                        <form asp-action="DeleteTask" method="post" onsubmit="return confirm('Czy na pewno chcesz usunąć to zadanie?');">
                                            <input type="hidden" name="id" value="@task.Id" />
                                            <button type="submit" class="btn btn-outline-danger">
                                                <i class="bi bi-trash"></i> Usuń
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center mt-4">
            <h5>Brak zadań</h5>
            <p>Nie utworzono jeszcze żadnych zadań. Kliknij przycisk powyżej, aby dodać pierwsze zadanie.</p>
        </div>
    }
</div>
