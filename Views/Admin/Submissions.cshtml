@model List<EventManageApp.Models.TaskSubmission>

@{
    ViewData["Title"] = "Weryfikacja Zgłoszeń";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-0">
                <i class="bi bi-clipboard-check"></i> Weryfikacja Zgłoszeń
            </h1>
            <p class="text-muted">Przeglądaj i zatwierdzaj zgłoszenia zadań od użytkowników</p>
        </div>
        <div class="col-md-4 text-end">
            <span class="badge bg-warning fs-6 text-dark">@Model.Where(s => !s.IsApproved && !s.IsRejected).Count() Oczekujących</span>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="mb-4">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">
                    Oczekujące <span class="badge bg-warning text-dark">@Model.Where(s => !s.IsApproved && !s.IsRejected).Count()</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="all-tab" data-bs-toggle="tab" data-bs-target="#all" type="button" role="tab">
                    Wszystkie <span class="badge bg-secondary">@Model.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="rejected-tab" data-bs-toggle="tab" data-bs-target="#rejected" type="button" role="tab">
                    Odrzucone <span class="badge bg-danger">@Model.Where(s => s.IsRejected).Count()</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="approved-tab" data-bs-toggle="tab" data-bs-target="#approved" type="button" role="tab">
                    Zatwierdzone <span class="badge bg-success">@Model.Where(s => s.IsApproved).Count()</span>
                </button>
            </li>
        </ul>
    </div>

    <!-- Tab Content -->
    <div class="tab-content">
        <!-- Pending Submissions -->
        <div class="tab-pane fade show active" id="pending" role="tabpanel">
            @{
                var pending = Model?.Where(s => !s.IsApproved && !s.IsRejected).ToList() ?? new List<EventManageApp.Models.TaskSubmission>();
            }
            @if (pending.Count > 0)
            {
                <div class="card shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Użytkownik</th>
                                    <th>Zadanie</th>
                                    <th>Przesłano</th>
                                    <th class="text-center">Akcje</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var submission in pending)
                                {
                                    <tr>
                                        <td>
                                            <div>@(submission.User?.Nickname ?? submission.User?.Login ?? "Nieznany")</div>
                                            <small class="text-muted">@(submission.User?.FirstName) @(submission.User?.LastName)</small>
                                        </td>
                                        <td>@(submission.Task?.Name ?? $"Zadanie {submission.TaskId}")</td>
                                        <td>
                                            <small class="text-muted">@submission.SubmittedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                        </td>
                                        <td class="text-center">
                                            <a href="@Url.Action("ReviewSubmission", "Admin", new { id = submission.Id })" class="btn btn-sm btn-primary">
                                                <i class="bi bi-eye"></i> Sprawdź
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-success text-center">
                    <p>Brak oczekujących zgłoszeń - dobra robota!</p>
                </div>
            }
        </div>

        <!-- All Submissions -->
        <div class="tab-pane fade" id="all" role="tabpanel">
            @if (Model != null && Model.Count > 0)
            {
                <div class="card shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Użytkownik</th>
                                    <th>Zadanie</th>
                                    <th>Przesłano</th>
                                    <th>Status</th>
                                    <th class="text-center">Akcje</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var submission in Model)
                                {
                                    <tr>
                                        <td>
                                            <div>@(submission.User?.Nickname ?? submission.User?.Login ?? "Nieznany")</div>
                                            <small class="text-muted">@(submission.User?.FirstName) @(submission.User?.LastName)</small>
                                        </td>
                                        <td>@(submission.Task?.Name ?? "Nieznany")</td>
                                        <td>
                                            <small class="text-muted">@submission.SubmittedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                        </td>
                                        <td>
                                            @if (submission.IsApproved)
                                            {
                                                <span class="badge bg-success">Zatwierdzone</span>
                                            }
                                            else if (submission.IsRejected)
                                            {
                                                <span class="badge bg-danger">Odrzucone</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Oczekujące</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <a href="@Url.Action("ReviewSubmission", "Admin", new { id = submission.Id })" class="btn btn-sm btn-primary">
                                                <i class="bi bi-eye"></i> Sprawdź
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <p>Nie znaleziono żadnych zgłoszeń</p>
                </div>
            }
        </div>

        <!-- Rejected Submissions -->
        <div class="tab-pane fade" id="rejected" role="tabpanel">
            @{ 
                var rejected = Model?.Where(s => s.IsRejected).ToList() ?? new List<EventManageApp.Models.TaskSubmission>();
            }
            @if (rejected.Count > 0)
            {
                <div class="card shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Użytkownik</th>
                                    <th>Zadanie</th>
                                    <th>Przesłano</th>
                                    <th>Powód odrzucenia</th>
                                    <th class="text-center">Akcje</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var submission in rejected)
                                {
                                    <tr>
                                        <td>
                                            <div>@(submission.User?.Nickname ?? submission.User?.Login ?? "Nieznany")</div>
                                            <small class="text-muted">@(submission.User?.FirstName) @(submission.User?.LastName)</small>
                                        </td>
                                        <td>@(submission.Task?.Name ?? $"Zadanie {submission.TaskId}")</td>
                                        <td>
                                            <small class="text-muted">@submission.SubmittedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                        </td>
                                        <td>@(submission.RejectionReason ?? "—")</td>
                                        <td class="text-center">
                                            <a href="@Url.Action("ReviewSubmission", "Admin", new { id = submission.Id })" class="btn btn-sm btn-info text-white">
                                                <i class="bi bi-eye"></i> Zobacz
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <p>Brak odrzuconych zgłoszeń</p>
                </div>
            }
        </div>

        <!-- Approved Submissions -->
        <div class="tab-pane fade" id="approved" role="tabpanel">
            @{
                var approved = Model?.Where(s => s.IsApproved).ToList() ?? new List<EventManageApp.Models.TaskSubmission>();
            }
            @if (approved.Count > 0)
            {
                <div class="card shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Użytkownik</th>
                                    <th>Zadanie</th>
                                    <th>Zatwierdził</th>
                                    <th>Data zatw.</th>
                                    <th class="text-center">Akcje</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var submission in approved)
                                {
                                    <tr>
                                        <td>
                                            <div>@(submission.User?.Nickname ?? submission.User?.Login ?? "Nieznany")</div>
                                            <small class="text-muted">@(submission.User?.FirstName) @(submission.User?.LastName)</small>
                                        </td>
                                        <td>@(submission.Task?.Name ?? $"Zadanie {submission.TaskId}")</td>
                                        <td>@submission.ApprovedBy</td>
                                        <td>
                                            <small class="text-muted">@submission.ApprovedAt?.ToString("dd.MM.yyyy HH:mm")</small>
                                        </td>
                                        <td class="text-center">
                                            <a href="@Url.Action("ReviewSubmission", "Admin", new { id = submission.Id })" class="btn btn-sm btn-info text-white">
                                                <i class="bi bi-eye"></i> Zobacz
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <p>Brak zatwierdzonych zgłoszeń</p>
                </div>
            }
        </div>
    </div>
</div>
