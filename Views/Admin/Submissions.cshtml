@model List<EventManageApp.Models.TaskSubmission>

@{
    ViewData["Title"] = "Review Submissions";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-0">
                <i class="bi bi-clipboard-check"></i> Review Submissions
            </h1>
            <p class="text-muted">Review and approve user task submissions</p>
        </div>
        <div class="col-md-4 text-end">
            <span class="badge bg-warning fs-6">@Model.Where(s => !s.IsApproved && !s.IsRejected).Count() Pending</span>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="mb-4">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="all-tab" data-bs-toggle="tab" data-bs-target="#all" type="button" role="tab">
                    All <span class="badge bg-secondary">@Model.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">
                    Pending <span class="badge bg-warning">@Model.Where(s => !s.IsApproved && !s.IsRejected).Count()</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="rejected-tab" data-bs-toggle="tab" data-bs-target="#rejected" type="button" role="tab">
                    Rejected <span class="badge bg-danger">@Model.Where(s => s.IsRejected).Count()</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="approved-tab" data-bs-toggle="tab" data-bs-target="#approved" type="button" role="tab">
                    Approved <span class="badge bg-success">@Model.Where(s => s.IsApproved).Count()</span>
                </button>
            </li>
        </ul>
    </div>

    <!-- Tab Content -->
    <div class="tab-content">
        <!-- All Submissions -->
        <div class="tab-pane fade show active" id="all" role="tabpanel">
            @if (Model != null && Model.Count > 0)
            {
                <div class="card shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>User</th>
                                    <th>Task</th>
                                    <th>Submitted</th>
                                    <th>Status</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var submission in Model)
                                {
                                    <tr>
                                        <td><code>#@submission.Id</code></td>
                                        <td>@(submission?.User?.Login ?? "Unknown")</td>
                                        <td>@(submission?.Task?.Name ?? "Unknown")</td>
                                        <td>
                                            <small class="text-muted">@submission.SubmittedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                        </td>
                                        <td>
                                            @if (submission.IsApproved)
                                            {
                                                <span class="badge bg-success">Approved</span>
                                            }
                                            else if (submission.IsRejected)
                                            {
                                                <span class="badge bg-danger">Rejected</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Pending</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <a href="@Url.Action("ReviewSubmission", "Admin", new { id = submission.Id })" class="btn btn-sm btn-primary">
                                                <i class="bi bi-eye"></i> Review
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <p>No submissions found</p>
                </div>
            }
        </div>

        <!-- Pending Submissions -->
        <div class="tab-pane fade" id="pending" role="tabpanel">
            @{
                var pending = Model?.Where(s => !s.IsApproved && !s.IsRejected).ToList() ?? new List<EventManageApp.Models.TaskSubmission>();
            }
            @if (pending.Count > 0)
            {
                <div class="card shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>User</th>
                                    <th>Task</th>
                                    <th>Submitted</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var submission in pending)
                                {
                                    <tr>
                                        <td><code>#@submission.Id</code></td>
                                        <td>@(submission?.User?.Login ?? "Unknown")</td>
                                        <td>Task @submission.TaskId</td>
                                        <td>
                                            <small class="text-muted">@submission.SubmittedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                        </td>
                                        <td class="text-center">
                                            <a href="@Url.Action("ReviewSubmission", "Admin", new { id = submission.Id })" class="btn btn-sm btn-primary">
                                                <i class="bi bi-eye"></i> Review
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-success text-center">
                    <p>No pending submissions - great work!</p>
                </div>
            }
        </div>

        <!-- Rejected Submissions -->
        <div class="tab-pane fade" id="rejected" role="tabpanel">
            @{ 
                var rejected = Model?.Where(s => s.IsRejected).ToList() ?? new List<EventManageApp.Models.TaskSubmission>();
            }
            @if (rejected.Count > 0)
            {
                <div class="card shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>User</th>
                                    <th>Task</th>
                                    <th>Submitted</th>
                                    <th>Reason</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var submission in rejected)
                                {
                                    <tr>
                                        <td><code>#@submission.Id</code></td>
                                        <td>@(submission?.User?.Login ?? "Unknown")</td>
                                        <td>Task @submission.TaskId</td>
                                        <td>
                                            <small class="text-muted">@submission.SubmittedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                        </td>
                                        <td>@(submission.RejectionReason ?? "—")</td>
                                        <td class="text-center">
                                            <a href="@Url.Action("ReviewSubmission", "Admin", new { id = submission.Id })" class="btn btn-sm btn-info">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <p>No rejected submissions</p>
                </div>
            }
        </div>

        <!-- Approved Submissions -->
        <div class="tab-pane fade" id="approved" role="tabpanel">
            @{
                var approved = Model?.Where(s => s.IsApproved).ToList() ?? new List<EventManageApp.Models.TaskSubmission>();
            }
            @if (approved.Count > 0)
            {
                <div class="card shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>User</th>
                                    <th>Task</th>
                                    <th>Approved By</th>
                                    <th>Approved</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var submission in approved)
                                {
                                    <tr>
                                        <td><code>#@submission.Id</code></td>
                                        <td>@(submission?.User?.Login ?? "Unknown")</td>
                                        <td>Task @submission.TaskId</td>
                                        <td>@submission.ApprovedBy</td>
                                        <td>
                                            <small class="text-muted">@submission.ApprovedAt?.ToString("MMM dd, yyyy HH:mm")</small>
                                        </td>
                                        <td class="text-center">
                                            <a href="@Url.Action("ReviewSubmission", "Admin", new { id = submission.Id })" class="btn btn-sm btn-info">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <p>No approved submissions yet</p>
                </div>
            }
        </div>
    </div>
</div>
