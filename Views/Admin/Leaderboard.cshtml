@model List<EventManageApp.Models.User>

@{
    ViewData["Title"] = "Zarządzanie Rankingiem";
    var users = Model ?? new List<EventManageApp.Models.User>();
    var isAdmin = User.IsInRole("Admin");
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-0">
                <i class="bi bi-trophy"></i> Zarządzanie Rankingiem
            </h1>
            <p class="text-muted">Podgląd uczestników i moderacja punktów/pseudonimów</p>
        </div>
    </div>

    @if (users.Count > 0)
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;">Ranga</th>
                            <th>Użytkownik (Login / Pseudonim)</th>
                            <th class="text-end">Punkty</th>
                            @if (isAdmin)
                            {
                                <th class="text-center" style="width: 350px;">Zarządzanie</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < users.Count; i++)
                        {
                            var user = users[i];
                            var rank = i + 1;
                            var badgeClass = rank == 1 ? "bg-warning text-dark" : 
                                           rank == 2 ? "bg-secondary text-white" : 
                                           rank == 3 ? "bg-danger text-white" : 
                                           "bg-info text-white";
                            
                            <tr>
                                <td>
                                    @if (rank <= 3)
                                    {
                                        <span class="badge @badgeClass fs-6">
                                            @if (rank == 1) { <i class="bi bi-award"></i> }
                                            @if (rank == 2) { <i class="bi bi-award"></i> }
                                            @if (rank == 3) { <i class="bi bi-award"></i> }
                                            #@rank
                                        </span>
                                    }
                                    else
                                    {
                                        <strong>#@rank</strong>
                                    }
                                </td>
                                <td>
                                    <div>
                                        <strong>@user.Login</strong>
                                        <br />
                                        <span class="text-primary">@user.FirstName @user.LastName</span>
                                        <br />
                                        <small class="text-muted">Nick: @(user.Nickname ?? "—")</small>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <span class="badge bg-success fs-6">@user.Points pkt</span>
                                </td>
                                @if (isAdmin)
                                {
                                    <td class="text-center">
                                        <div class="d-flex flex-column gap-2">
                                            <!-- Points adjustment -->
                                            <form asp-action="UpdateUserPoints" method="post" class="d-flex justify-content-center align-items-center gap-2">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <div class="input-group input-group-sm">
                                                    <span class="input-group-text">Pkt</span>
                                                    <input type="number" name="newPoints" value="@user.Points" class="form-control" style="max-width: 80px;" required />
                                                    <button type="submit" class="btn btn-outline-primary">Zapisz</button>
                                                </div>
                                            </form>
                                            
                                            <!-- Nickname adjustment -->
                                            <form asp-action="UpdateNickname" method="post" class="d-flex justify-content-center align-items-center gap-2">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <div class="input-group input-group-sm">
                                                    <span class="input-group-text">Nick</span>
                                                    <input type="text" name="newNickname" value="@user.Nickname" class="form-control" placeholder="Zmień nick" required />
                                                    <button type="submit" class="btn btn-outline-warning">Zmień</button>
                                                </div>
                                            </form>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center mt-4">
            <h5>Brak użytkowników</h5>
            <p>Użytkownicy pojawią się tutaj po zarejestrowaniu w systemie</p>
        </div>
    }
</div>
