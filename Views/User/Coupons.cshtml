@model List<EventManageApp.Models.Coupon>

@{
    ViewData["Title"] = "My Coupons";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1><i class="bi bi-ticket-perforated"></i> My Coupons</h1>
            <p class="text-muted">Show these QR codes to the scaner to redeem your coupons.</p>
        </div>
    </div>

    <div class="row">
        @if (Model.Count == 0)
        {
            <div class="col-12 text-center mt-5">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle fs-3"></i>
                    <p class="mt-2">You don't have any coupons yet.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var coupon in Model)
            {
                var isExpired = DateTime.Now > coupon.EndDate;
                var isActive = DateTime.Now >= coupon.StartDate && DateTime.Now <= coupon.EndDate && !coupon.IsUsed;
                
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100 @(coupon.IsUsed ? "bg-light opacity-75" : "")">
                        <div class="card-header @(isActive ? "bg-success text-white" : isExpired || coupon.IsUsed ? "bg-secondary text-white" : "bg-info text-white")">
                            <h5 class="mb-0 text-center">@coupon.Title</h5>
                        </div>
                        <div class="card-body text-center d-flex flex-column align-items-center">
                            @if (!coupon.IsUsed && !isExpired)
                            {
                                <div id="qrcode-@coupon.SerialNumber" class="mb-3 p-2 bg-white shadow-sm rounded"></div>
                                <code class="d-block mb-3">@coupon.SerialNumber</code>
                            }
                            else if (coupon.IsUsed)
                            {
                                <div class="py-4">
                                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                                    <h4 class="mt-2">USED</h4>
                                    <small class="text-muted">@coupon.UsedAt?.ToString("MMM dd, HH:mm")</small>
                                </div>
                            }
                            else
                            {
                                <div class="py-4">
                                    <i class="bi bi-calendar-x text-danger" style="font-size: 4rem;"></i>
                                    <h4 class="mt-2 text-danger">EXPIRED</h4>
                                </div>
                            }
                            
                            <hr class="w-100" />
                            <div class="text-start w-100">
                                <p class="mb-1"><small><strong>Valid From:</strong> @coupon.StartDate.ToString("MMM dd, yyyy")</small></p>
                                <p class="mb-0"><small><strong>Valid Until:</strong> @coupon.EndDate.ToString("MMM dd, yyyy")</small></p>
                            </div>
                        </div>
                        <div class="card-footer text-center">
                            @if (isActive)
                            {
                                <span class="badge bg-success">ACTIVE</span>
                            }
                            else if (coupon.IsUsed)
                            {
                                <span class="badge bg-secondary">REDEEMED</span>
                            }
                            else if (isExpired)
                            {
                                <span class="badge bg-danger">EXPIRED</span>
                            }
                            else
                            {
                                <span class="badge bg-info">UPCOMING</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        $(document).ready(function() {
            @foreach (var coupon in Model.Where(c => !c.IsUsed && DateTime.Now <= c.EndDate))
            {
                <text>
                new QRCode(document.getElementById("qrcode-@coupon.SerialNumber"), {
                    text: "@coupon.SerialNumber",
                    width: 150,
                    height: 150
                });
                </text>
            }
        });
    </script>
}
