@model List<EventManageApp.Models.Coupon>

@{
    ViewData["Title"] = "Moje Kupony";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-0">
                <i class="bi bi-ticket-perforated"></i> Moje Kupony
            </h1>
            <p class="text-muted">Kupony na jedzenie i inne nagrody</p>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="row">
            @foreach (var coupon in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100 @(coupon.IsUsed ? "bg-light opacity-75" : "border-primary")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="card-title text-primary">@coupon.Title</h5>
                                @if (coupon.IsUsed)
                                {
                                    <span class="badge bg-secondary">Wykorzystany</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Aktywny</span>
                                }
                            </div>
                            
                            <div class="text-center my-3 p-3 bg-white rounded border border-dashed">
                                <p class="text-muted small mb-1">Numer seryjny:</p>
                                <h4 class="font-monospace mb-0">@coupon.SerialNumber</h4>
                            </div>

                            <div class="small text-muted mt-3">
                                <p class="mb-1"><i class="bi bi-calendar-event"></i> Ważny od: @coupon.StartDate.ToString("dd.MM.yyyy")</p>
                                <p class="mb-1"><i class="bi bi-calendar-x"></i> Ważny do: @coupon.EndDate.ToString("dd.MM.yyyy")</p>
                                @if (coupon.IsUsed)
                                {
                                    <p class="mb-0 text-danger"><i class="bi bi-check-circle-fill"></i> Wykorzystano: @coupon.UsedAt?.ToString("dd.MM.yyyy HH:mm")</p>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-top-0 pb-3">
                            @if (!coupon.IsUsed)
                            {
                                <div class="text-center">
                                    <small class="text-primary"><i class="bi bi-info-circle"></i> Pokaż ten kod przy skanowaniu</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center mt-5 py-5 shadow-sm">
            <i class="bi bi-ticket-perforated fs-1"></i>
            <h4 class="mt-3">Nie masz jeszcze żadnych kuponów</h4>
            <p>Kupony pojawią się tutaj, gdy zostaną Ci przyznane przez organizatorów</p>
        </div>
    }
</div>
