@model List<EventManageApp.Models.User>

@{
    ViewData["Title"] = "Results Board";
    var users = Model ?? new List<EventManageApp.Models.User>();
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-0">
                <i class="bi bi-trophy"></i> Results Board
            </h1>
            <p class="text-muted">User rankings by points earned</p>
        </div>
    </div>

    @if (users.Count > 0)
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;">Rank</th>
                            <th>Username</th>
                            <th class="text-end">Current Points</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < users.Count; i++)
                        {
                            var user = users[i];
                            var rank = i + 1;
                            var badgeClass = rank == 1 ? "bg-warning text-dark" : 
                                           rank == 2 ? "bg-secondary" : 
                                           rank == 3 ? "bg-danger" : 
                                           "bg-info";
                            
                            <tr>
                                <td>
                                    @if (rank <= 3)
                                    {
                                        <span class="badge @badgeClass fs-6">
                                            @if (rank == 1) { <i class="bi bi-award"></i> }
                                            @if (rank == 2) { <i class="bi bi-award"></i> }
                                            @if (rank == 3) { <i class="bi bi-award"></i> }
                                            #@rank
                                        </span>
                                    }
                                    else
                                    {
                                        <strong>#@rank</strong>
                                    }
                                </td>
                                <td>
                                    <strong>@user.Login</strong>
                                </td>
                                <td class="text-end">
                                    <span class="badge bg-success fs-6">@user.Points pts</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center mt-4">
            <h5>No users yet</h5>
            <p>Users will appear here as they earn points</p>
        </div>
    }
</div>
