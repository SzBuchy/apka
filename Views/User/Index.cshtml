@model List<EventManageApp.Models.Task>

@{
    ViewData["Title"] = "Available Tasks";
    var currentUser = ViewBag.CurrentUser as EventManageApp.Models.User;
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-0">Available Tasks</h1>
            <p class="text-muted">Complete tasks and earn points</p>
        </div>
        <div class="col-md-4 text-end">
            @if (currentUser != null)
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <h6 class="card-title text-muted mb-1">Your Points</h6>
                        <h3 class="text-success">@currentUser.Points <small>pts</small></h3>
                        <small class="text-muted">@currentUser.Login</small>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="row">
            @foreach (var task in Model)
            {
                // Find the most recent submission for this task by current user
                var submission = currentUser?.TaskSubmissions?.OrderByDescending(s => s.SubmittedAt)
                    .FirstOrDefault(s => s.TaskId == task.Id);
                
                    var badgeClass = "";
                    var statusText = "";
                    var isDisabled = false;
                    var canResubmit = false;

                    if (submission != null)
                    {
                        if (submission.IsApproved)
                        {
                            badgeClass = "bg-success";
                            statusText = "Approved";
                            isDisabled = true;
                        }
                        else if (submission.IsRejected)
                        {
                            badgeClass = "bg-danger";
                            statusText = "Rejected";
                            canResubmit = true;
                        }
                        else
                        {
                            badgeClass = "bg-warning text-dark";
                            statusText = "Pending";
                            isDisabled = true;
                        }
                    }

                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100 @(isDisabled && !canResubmit ? "opacity-50" : "")">
                        @if (submission != null && !canResubmit)
                        {
                            <div class="card-header bg-light">
                                <span class="badge @badgeClass">@statusText</span>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@task.Name</h5>
                            <p class="card-text text-muted flex-grow-1">@task.Description</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-success">@task.Points pts</span>
                                @if (!isDisabled || canResubmit)
                                {
                                    <a href="@Url.Action("Details", "User", new { id = task.Id })" class="btn btn-sm btn-primary">
                                        @if (canResubmit)
                                        {
                                            <span>Resubmit</span>
                                        }
                                        else
                                        {
                                            <span>View & Submit</span>
                                        }
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-secondary" disabled>
                                        <span>@statusText</span>
                                    </button>
                                }
                            </div>
                            @if (submission?.IsRejected == true && !string.IsNullOrEmpty(submission.RejectionReason))
                            {
                                <small class="text-danger mt-2">Reason: @submission.RejectionReason</small>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center mt-4">
            <h5>No tasks available</h5>
            <p>Please check back later for new tasks</p>
        </div>
    }
</div>
