@model EventManageApp.Models.Task

@{
    ViewData["Title"] = Model?.Name ?? "Task Details";
    var currentUser = ViewBag.CurrentUser as EventManageApp.Models.User;
    var submission = currentUser?.TaskSubmissions?.OrderByDescending(s => s.SubmittedAt)
        .FirstOrDefault(s => s.TaskId == Model?.Id);
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <a href="@Url.Action("Index", "User")" class="btn btn-secondary mb-3">← Back to Tasks</a>
            <h1>@Model?.Name</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <!-- Task Description -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Task Description</h5>
                </div>
                <div class="card-body">
                    <p>@Model?.Description</p>
                </div>
            </div>

            <!-- Task Details -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Task Details</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Task ID</dt>
                        <dd class="col-sm-9">@Model?.Id</dd>

                        <dt class="col-sm-3">Points Available</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-success fs-6">@Model?.Points pts</span>
                        </dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            @if (submission?.IsApproved == true)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (submission?.IsRejected == true)
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                            else if (submission != null && !submission.IsApproved && !submission.IsRejected)
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else
                            {
                                <span class="badge bg-info">Available</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            @if (submission?.IsRejected == true)
            {
                <div class="alert alert-warning mb-4">
                    <h5>Submission Rejected</h5>
                    <p class="mb-0">@submission.RejectionReason</p>
                    <p class="mt-2 mb-0">You can submit a new answer below.</p>
                </div>
            }

            <!-- Submit Answer Form - only show if not approved or pending, or if rejected (allow resubmit) -->
            @if (submission?.IsApproved != true && submission?.IsRejected != false)
            {
                <div class="card shadow-sm border-primary">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Submit Your Answer</h5>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-action="SubmitAnswer" enctype="multipart/form-data">
                            <input type="hidden" name="taskId" value="@Model?.Id" />

                            <div class="mb-3">
                                <label for="answer" class="form-label">Your Answer</label>
                                <textarea 
                                    class="form-control" 
                                    id="answer" 
                                    name="answer" 
                                    rows="6" 
                                    placeholder="Enter your answer, solution, or work here..."
                                    required></textarea>
                                <small class="text-muted d-block mt-2">
                                    You can include code snippets, explanations, or any relevant information to complete this task.
                                </small>
                            </div>

                            @if (Model?.RequiresPhoto == true)
                            {
                                <div class="mb-3">
                                    <label for="submissionFile" class="form-label">
                                        <span class="badge bg-warning text-dark me-2">Required</span>Photo/Image
                                    </label>
                                    <input 
                                        type="file" 
                                        class="form-control" 
                                        id="submissionFile" 
                                        name="submissionFile" 
                                        accept="image/*"
                                        required />
                                    <small class="text-muted d-block mt-2">
                                        Upload a photo or image to support your submission (JPG, PNG, etc.)
                                    </small>
                                </div>
                            }

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <a href="@Url.Action("Index", "User")" class="btn btn-secondary">Cancel</a>
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-check-circle"></i> Submit Answer
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else if (submission?.IsApproved == true)
            {
                <div class="alert alert-success" role="alert">
                    <h5 class="alert-heading">
                        <i class="bi bi-check-circle"></i> Submission Approved
                    </h5>
                    <p>Congratulations! Your submission was approved.</p>
                    @if (!string.IsNullOrEmpty(submission.ApprovalNotes))
                    {
                        <hr>
                        <p><strong>Feedback:</strong> @submission.ApprovalNotes</p>
                    }
                </div>
            }
            else if (submission != null && !submission.IsApproved && !submission.IsRejected)
            {
                <div class="alert alert-warning" role="alert">
                    <h5 class="alert-heading">
                        <i class="bi bi-hourglass-split"></i> Submission Pending
                    </h5>
                    <p>Your submission is being reviewed. Please wait for feedback from an admin.</p>
                    <small>Submitted: @submission.SubmittedAt.ToString("dddd, MMMM dd, yyyy 'at' HH:mm:ss")</small>
                    
                    @if (!string.IsNullOrEmpty(submission?.CloudinaryUrl) || (submission?.SubmissionFile != null && submission.SubmissionFile.Length > 0))
                    {
                        <div class="mt-3">
                            <strong>Submitted Photo:</strong>
                            @if (!string.IsNullOrEmpty(submission.CloudinaryUrl))
                            {
                                <div class="mt-2">
                                    <a href="@submission.CloudinaryUrl" target="_blank">
                                        <img src="@submission.CloudinaryUrl" 
                                             alt="Submission" 
                                             class="img-fluid rounded shadow-sm" 
                                             style="max-width: 100%; max-height: 300px;" />
                                    </a>
                                </div>
                            }
                            else if (submission.SubmissionFile != null && submission.SubmissionFile.Length > 0)
                            {
                                @if (submission.FileContentType?.StartsWith("image/") == true)
                                {
                                    <div class="mt-2">
                                        <img src="@Url.Action("SubmissionFile", "Admin", new { id = submission.Id })" 
                                             alt="Submission" 
                                             class="img-fluid rounded" 
                                             style="max-width: 100%; max-height: 300px;" />
                                    </div>
                                }
                                else
                                {
                                    <div class="mt-2">
                                        <a href="@Url.Action("SubmissionFile", "Admin", new { id = submission.Id })" download="@submission.FileName">
                                            Download file (@submission.FileName)
                                        </a>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            }

            <!-- Info Alert -->
            <div class="alert alert-info mt-4" role="alert">
                <strong>📋 How it works:</strong>
                <ul class="mb-0 mt-2">
                    <li>Submit your answer or solution to this task</li>
                    @if (Model?.RequiresPhoto == true)
                    {
                        <li>Include a photo/image with your submission</li>
                    }
                    <li>An admin will review your submission</li>
                    <li>Once approved, you'll earn <strong>@Model?.Points points</strong></li>
                    <li>If rejected, you can submit another answer</li>
                </ul>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Task Info Card -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Task Info</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-2">Reward: <span class="badge bg-success">@Model?.Points points</span></p>
                    <p class="text-muted mb-2">Status: 
                        @if (submission?.IsApproved == true)
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else if (submission?.IsRejected == true)
                        {
                            <span class="badge bg-danger">Rejected</span>
                        }
                        else if (submission != null)
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                        else
                        {
                            <span class="badge bg-info">Available</span>
                        }
                    </p>
                </div>
            </div>

            <!-- Requirements Card -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Requirements</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li><i class="bi bi-check-circle text-success"></i> Clear and detailed answer</li>
                        <li><i class="bi bi-check-circle text-success"></i> Proper formatting</li>
                        <li><i class="bi bi-check-circle text-success"></i> Complete solution</li>
                        <li><i class="bi bi-check-circle text-success"></i> Explanation of approach</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
