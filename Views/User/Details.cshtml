@model EventManageApp.Models.Task

@{
    ViewData["Title"] = Model?.Name ?? "Szczegóły zadania";
    var currentUser = ViewBag.CurrentUser as EventManageApp.Models.User;
    var submission = currentUser?.TaskSubmissions?.OrderByDescending(s => s.SubmittedAt)
        .FirstOrDefault(s => s.TaskId == Model?.Id);
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <a href="@Url.Action("Index", "User")" class="btn btn-secondary mb-3">← Powrót do zadań</a>
            <h1>@Model?.Name</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <!-- Task Description -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Opis zadania</h5>
                </div>
                <div class="card-body">
                    <p>@Model?.Description</p>
                </div>
            </div>

            <!-- Task Details -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Szczegóły zadania</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Dostępne punkty</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-success fs-6">@Model?.Points pkt</span>
                        </dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            @if (submission?.IsApproved == true)
                            {
                                <span class="badge bg-success">Zatwierdzone</span>
                            }
                            else if (submission?.IsRejected == true)
                            {
                                <span class="badge bg-danger">Odrzucone</span>
                            }
                            else if (submission != null && !submission.IsApproved && !submission.IsRejected)
                            {
                                <span class="badge bg-warning text-dark">Oczekiwanie</span>
                            }
                            else
                            {
                                <span class="badge bg-info">Dostępne</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            @if (submission?.IsRejected == true)
            {
                <div class="alert alert-warning mb-4">
                    <h5>Zgłoszenie odrzucone</h5>
                    <p class="mb-0">@submission.RejectionReason</p>
                    <p class="mt-2 mb-0">Możesz przesłać nową odpowiedź poniżej.</p>
                </div>
            }

            <!-- Submit Answer Form - only show if not approved or pending, or if rejected (allow resubmit) -->
            @if (submission?.IsApproved != true && (submission == null || submission.IsRejected))
            {
                <div class="card shadow-sm border-primary">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Prześlij swoją odpowiedź</h5>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-action="SubmitAnswer" enctype="multipart/form-data">
                            <input type="hidden" name="taskId" value="@Model?.Id" />

                            <div class="mb-3">
                                <label for="answer" class="form-label">Twoja odpowiedź @(Model?.RequiresPhoto == true ? "(Opcjonalnie)" : "")</label>
                                <textarea 
                                    class="form-control" 
                                    id="answer" 
                                    name="answer" 
                                    rows="6" 
                                    placeholder="Wpisz swoją odpowiedź, rozwiązanie lub opis tutaj..."
                                    @(Model?.RequiresPhoto == true ? "" : "required")></textarea>
                                <small class="text-muted d-block mt-2">
                                    Możesz dołączyć fragmenty kodu, wyjaśnienia lub wszelkie istotne informacje potrzebne do wykonania tego zadania.
                                </small>
                            </div>

                            @if (Model?.RequiresPhoto == true)
                            {
                                <div class="mb-3">
                                    <label for="submissionFile" class="form-label">
                                        <span class="badge bg-warning text-dark me-2">Wymagane</span>Zdjęcie/Wideo
                                    </label>
                                    <input 
                                        type="file" 
                                        class="form-control" 
                                        id="submissionFile" 
                                        name="submissionFile" 
                                        accept="image/*,video/*"
                                        required />
                                    <small class="text-muted d-block mt-2">
                                        Prześlij zdjęcie lub wideo jako dowód wykonania zadania (JPG, PNG, MP4 itp.)
                                    </small>
                                </div>
                            }

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <a href="@Url.Action("Index", "User")" class="btn btn-secondary">Anuluj</a>
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-check-circle"></i> Prześlij odpowiedź
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else if (submission?.IsApproved == true)
            {
                <div class="alert alert-success" role="alert">
                    <h5 class="alert-heading">
                        <i class="bi bi-check-circle"></i> Zgłoszenie zatwierdzone
                    </h5>
                    <p>Gratulacje! Twoje zgłoszenie zostało zatwierdzone.</p>
                    @if (!string.IsNullOrEmpty(submission.ApprovalNotes))
                    {
                        <hr>
                        <p><strong>Opinia:</strong> @submission.ApprovalNotes</p>
                    }
                </div>
            }
            else if (submission != null && !submission.IsApproved && !submission.IsRejected)
            {
                <div class="alert alert-warning" role="alert">
                    <h5 class="alert-heading">
                        <i class="bi bi-hourglass-split"></i> Zgłoszenie w trakcie weryfikacji
                    </h5>
                    <p>Twoje zgłoszenie jest sprawdzane przez administratora. Proszę czekać na decyzję.</p>
                    <small>Przesłano: @submission.SubmittedAt.ToString("dddd, dd MMMM yyyy 'o' HH:mm:ss")</small>
                    
                    @if (!string.IsNullOrEmpty(submission?.CloudinaryUrl) || (submission?.SubmissionFile != null && submission.SubmissionFile.Length > 0))
                    {
                        <div class="mt-3">
                            <strong>Przesłane zdjęcie/wideo:</strong>
                            @if (!string.IsNullOrEmpty(submission.CloudinaryUrl))
                            {
                                <div class="mt-2">
                                    @if (submission.FileContentType?.StartsWith("video/") == true || submission.CloudinaryUrl.EndsWith(".mp4") || submission.CloudinaryUrl.EndsWith(".mov"))
                                    {
                                        <video controls class="img-fluid rounded shadow-sm" style="max-width: 100%; max-height: 400px;">
                                            <source src="@submission.CloudinaryUrl" type="@submission.FileContentType">
                                            Twoja przeglądarka nie obsługuje tagu wideo.
                                        </video>
                                    }
                                    else
                                    {
                                        <a href="@submission.CloudinaryUrl" target="_blank">
                                            <img src="@submission.CloudinaryUrl" 
                                                 alt="Zgłoszenie" 
                                                 class="img-fluid rounded shadow-sm" 
                                                 style="max-width: 100%; max-height: 300px;" />
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Info Alert -->
            <div class="alert alert-info mt-4" role="alert">
                <strong>📋 Jak to działa:</strong>
                <ul class="mb-0 mt-2">
                    <li>Prześlij swoją odpowiedź lub rozwiązanie tego zadania</li>
                    @if (Model?.RequiresPhoto == true)
                    {
                        <li>Dołącz zdjęcie lub wideo do swojego zgłoszenia</li>
                    }
                    <li>Administrator zweryfikuje Twoje zgłoszenie</li>
                    <li>Po zatwierdzeniu otrzymasz <strong>@Model?.Points punktów</strong></li>
                    <li>Jeśli zgłoszenie zostanie odrzucone, możesz spróbować ponownie</li>
                </ul>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Task Info Card -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Informacje o zadaniu</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-2">Nagroda: <span class="badge bg-success">@Model?.Points pkt</span></p>
                    <p class="text-muted mb-2">Status: 
                        @if (submission?.IsApproved == true)
                        {
                            <span class="badge bg-success">Zatwierdzone</span>
                        }
                        else if (submission?.IsRejected == true)
                        {
                            <span class="badge bg-danger">Odrzucone</span>
                        }
                        else if (submission != null)
                        {
                            <span class="badge bg-warning text-dark">Oczekiwanie</span>
                        }
                        else
                        {
                            <span class="badge bg-info">Dostępne</span>
                        }
                    </p>
                </div>
            </div>

            <!-- Requirements Card -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Wymagania</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li><i class="bi bi-check-circle text-success"></i> Jasna i szczegółowa odpowiedź</li>
                        <li><i class="bi bi-check-circle text-success"></i> Poprawne formatowanie</li>
                        <li><i class="bi bi-check-circle text-success"></i> Kompletne rozwiązanie</li>
                        <li><i class="bi bi-check-circle text-success"></i> Wyjaśnienie podejścia</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
