@{
    ViewData["Title"] = "Scaner Dashboard";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-qr-code-scan"></i> Scan Coupon</h4>
                </div>
                <div class="card-body">
                    <div id="reader" style="width: 100%; min-height: 300px;"></div>
                    <div id="result" class="mt-3"></div>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0"><i class="bi bi-bar-chart"></i> Today's Stats</h4>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush" id="stats-list">
                        @foreach (var stat in ViewBag.Stats)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @stat.Title
                                <span class="badge bg-primary rounded-pill">@stat.Count</span>
                            </li>
                        }
                    </ul>
                    @if (ViewBag.Stats.Count == 0)
                    {
                        <p class="text-muted text-center mt-3">No coupons scanned yet today.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function onScanSuccess(decodedText, decodedResult) {
            // Stop scanning temporarily
            html5QrcodeScanner.pause();
            
            // Send to server for validation
            $.post('/Scaner/ValidateCoupon', { serialNumber: decodedText }, function(response) {
                if (response.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Valid Coupon!',
                        text: response.title + ' for user ' + response.user,
                        confirmButtonText: 'Next Scan'
                    }).then(() => {
                        location.reload(); // Refresh to update stats
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Invalid Coupon',
                        text: response.message,
                        confirmButtonText: 'Try Again'
                    }).then(() => {
                        html5QrcodeScanner.resume();
                    });
                }
            });
        }

        let html5QrcodeScanner = new Html5QrcodeScanner(
            "reader", { fps: 10, qrbox: 250 });
        html5QrcodeScanner.render(onScanSuccess);
    </script>
}
